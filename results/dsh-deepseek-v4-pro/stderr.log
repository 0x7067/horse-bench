Now, writing the animation:

```js
const T = 0.85;
let t = 0;
const w = Math.PI*2/T;
function anim(){
  const dt = clock.getDelta();
  t += dt;
  // loop t for cleanliness not needed since sin periodic
  const th = t * w; // full cycle angle
  const A = 0.62; // swing amplitude
  // gallop: front pair vs hind pair opposite
  const front = Math.sin(th);
  const hind  = Math.sin(th + Math.PI);
  legs.forEach((L,i)=>{
     const isHind = i>=2;
     L.leg.rotation.x = (isHind? hind : front) * A;
     // knee fold
     const fold = Math.max(0, Math.cos(th + (isHind? Math.PI*0.5:0))) * 0.9;
     L.knee.rotation.x = fold;
  });
```


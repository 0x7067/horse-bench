Implementation details:

```js
function box(w,h,d,color){
  const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d),
     new THREE.MeshStandardMaterial({color, flatShading:true, roughness:0.8}));
  m.castShadow = true; m.receiveShadow = true;
  return m;
}
```

Legs: 
```js
function makeLeg(color, hoofColor){
  const leg = new THREE.Group();
  const upper = box(0.16, 0.5, 0.16, color);
  upper.position.y = -0.25;
  leg.add(upper);
  const knee = new THREE.Group();
  knee.position.y = -0.5;
  leg.add(knee);
  const lower = box(0.12, 0.45, 0.12, color);
  lower.position.y = -0.2;
  knee.add(lower);
  const hoof = box(0.14, 0.12, 0.16, hoofColor);
  hoof.position.y = -0.45;
  knee.add(hoof);
  return {leg, knee};
}
```


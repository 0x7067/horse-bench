```js
const trunkMat = new THREE.MeshStandardMaterial({ color: 0x2c2318, roughness: 1, flatShading: true });
const leafMat = new THREE.MeshStandardMaterial({ color: 0x27402c, roughness: 1, flatShading: true });
for (let i = 0; i < 16; i++) {
  const a = (i / 16) * Math.PI * 2 + 0.4;
  const r = 9 + ((i * 7) % 5) * 1.1;
  const s = 0.8 + ((i * 13) % 5) * 0.18;
  const tree = new THREE.Group();
  const h = 2.2 * s;
  tree.add(part(box(0.22*s, h, 0.22*s), trunkMat, 0, h/2, 0));
  const canopy = new THREE.Mesh(new THREE.ConeGeometry(0.95*s, 1.9*s, 6), leafMat);
  canopy.position.y = h + 0.7*s;
  canopy.castShadow = true;
  tree.add(canopy);
  tree.position.set(Math.cos(a)*r, 0, Math.sin(a)*r);
  scene.add(tree);
}
```

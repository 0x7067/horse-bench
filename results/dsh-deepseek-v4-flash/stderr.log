```js
const PERIOD = 0.78;
const clock = new THREE.Clock();

renderer.setAnimationLoop(() => {
  const t = (clock.getElapsedTime() / PERIOD) % 1;
  const w = t * Math.PI * 2;

  pivot.position.y = 1.45 + 0.075 * Math.sin(w + 1.1);
  pivot.rotation.x = 0.055 * Math.sin(w + 1.9);
  pivot.rotation.z = 0.03 * Math.sin(w);

  for (const g of gait) {
    const p = (t - g.phase) * Math.PI * 2;
    const swing = Math.sin(p);
    const fold = Math.max(0, Math.sin(p));
    g.leg.hip.rotation.x = -swing * g.swing;
    g.leg.knee.rotation.x = g.base + fold * fold * g.flex;
  }

  neck.rotation.x = 0.75 + 0.10 * Math.sin(w + Math.PI + 0.9);
  head.rotation.x = -0.72 - (neck.rotation.x - 0.75);

  tailRoot.rotation.x = 0.50 + 0.10 * Math.sin(w + 0.6);
  tailRoot.rotation.z = 0.09 * Math.sin(w + 1.4);
  tailSegs.forEach((g, i) => {
    g.rotation.z = 0.14 * Math.sin(w - i * 0.8);
    g.rotation.x = 0.12 * Math.sin(w - i * 0.9 + 1.2);
  });

  controls.update();
  renderer.render(scene, camera);
});
```

